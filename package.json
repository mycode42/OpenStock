{
  "name": "openstock",
  "version": "3.1.4",
  "description": "Alpaca-native stock dashboard and journal",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "NODE_ENV=test node --test --test-reporter=dot",
    "test:verbose": "NODE_ENV=test node --test --test-reporter=spec",
    "start": "node server.js",
    "demo": "node scripts/demo.js",
    "monitor": "node scripts/monitor.js",
    "check": "node scripts/check-pwa-assets.js && find . -path './node_modules' -prune -o -name '*.js' -type f -print0 | xargs -0 -n1 node --check",
    "audit:prod": "npm audit --omit=dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "sharp": "^0.35.4"
  }
}
