# OpenStock Algo jobs. Install with: crontab ops/crontab
# Edit the one ALGO line below if the checkout moves; every other path is relative to it. Jobs run the project venv
# directly (no OpenClaw, no poetry run) and each writes to its own log in data/algo/logs/. Logs are capped daily.
CRON_TZ=America/New_York
ALGO=/opt/OpenStock/algo-trader
MAILTO=""

# Health check, every hour (sources scripts/cron-env.sh so systemctl --user can see the services)
0 * * * *      cd $ALGO && . scripts/cron-env.sh && .venv/bin/python -m portfolio.healthcheck >> data/algo/logs/health.log 2>&1

# Options capture (Alpaca OPRA)
35 9 * * 1-5   cd $ALGO && .venv/bin/python -m scripts.options.alpaca_daily_capture --phase open --universe research >> data/algo/logs/options-opening-capture.log 2>&1
45 15 * * 1-5  cd $ALGO && .venv/bin/python -m scripts.options.alpaca_daily_capture --universe research >> data/algo/logs/options-history-capture.log 2>&1

# ThetaData history pipeline: last 20 sessions, then EOD, then opening. Resumes daily until complete, then stops calling ThetaData.
0 3 * * *      cd $ALGO && .venv/bin/python -m scripts.options.theta_pipeline >> data/algo/logs/theta-pipeline.log 2>&1

# LLM-driven silent run: refresh the signal snapshot, hourly 04:00-20:00 ET on weekdays
0 4-20 * * 1-5 cd $ALGO && .venv/bin/python -m strategies.llm_driven.ai_runner --ttl-minutes 90 >> data/algo/logs/llm-silent-run.log 2>&1

# Morning digest from the latest snapshot
45 7 * * 1-5   cd $ALGO && .venv/bin/python scripts/llm_report.py --prompt ops/prompts/llm-digest.md --snapshot --telegram >> data/algo/logs/llm-digest.log 2>&1

# Research reports: run the research cycle, then report on its output
0 17 * * *     cd $ALGO && { .venv/bin/python -m research.options && .venv/bin/python scripts/llm_report.py --prompt ops/prompts/options-research.md --context data/options/research/automation/latest.md --telegram; } >> data/algo/logs/options-research.log 2>&1
0 20 * * *     cd $ALGO && { .venv/bin/python -m research.equity && .venv/bin/python scripts/llm_report.py --prompt ops/prompts/equity-research.md --context data/research/algo-auto/latest.json --telegram; } >> data/algo/logs/equity-research.log 2>&1

# Keep the logs small
30 4 * * *     cd $ALGO && .venv/bin/python scripts/rotate_logs.py >> data/algo/logs/rotate.log 2>&1
