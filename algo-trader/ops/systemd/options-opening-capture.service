# Template: scripts/install_units.py renders {ROOT}, {ENV_FILE}, and {PYTHON} into ~/.config/systemd/user.
# Started by options-opening-capture.timer (America/New_York). Output appends to data/algo/logs/.
[Unit]
Description=Alpaca OPRA opening capture

[Service]
Type=oneshot
TimeoutStartSec=12h
WorkingDirectory={ROOT}
EnvironmentFile={ENV_FILE}
Environment=PYTHONUNBUFFERED=1
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
ExecStart={PYTHON} -m scripts.options.alpaca_daily_capture --phase open --universe research --log-file data/algo/logs/options-opening-capture.log
StandardOutput=journal
StandardError=append:{ROOT}/data/algo/logs/options-opening-capture.log
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths={ROOT}/data /run/lock

[Install]
WantedBy=default.target
