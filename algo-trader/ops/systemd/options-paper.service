[Unit]
Description=Options paper strategy daemon
After=network-online.target algo-trader.service
Wants=network-online.target

[Service]
Type=simple
User=openclaw
Group=openclaw
WorkingDirectory=/opt/algo-trader
EnvironmentFile=/opt/algo-trader/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/local/bin/poetry run python -m options.daemon --submit --interval-seconds 900 --opening-delay-minutes 10 --entry-cutoff-minutes 15
Restart=on-failure
RestartSec=15
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/algo-trader/data /run/lock
StandardOutput=journal
StandardError=journal
SyslogIdentifier=options-paper

[Install]
WantedBy=multi-user.target
