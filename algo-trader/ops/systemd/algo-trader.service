[Unit]
Description=Algo Trader autonomous strategy portfolio daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=openclaw
Group=openclaw
WorkingDirectory=/opt/OpenStock/algo-trader
EnvironmentFile=/opt/OpenStock/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/openclaw/.cache/pypoetry/virtualenvs/algo-trader-lprB-8wK-py3.12/bin/python -m portfolio.daemon --mode algo
Restart=on-failure
RestartSec=15
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/OpenStock/algo-trader/data /run/lock
StandardOutput=journal
StandardError=journal
SyslogIdentifier=algo-trader

[Install]
WantedBy=multi-user.target
