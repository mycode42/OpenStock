# Template: scripts/install_units.py renders {ROOT}, {ENV_FILE}, and {PYTHON} into ~/.config/systemd/user.
# Started by health.timer (America/New_York). Output appends to data/algo/logs/.
[Unit]
Description=Algo health check

[Service]
Type=oneshot
TimeoutStartSec=12h
WorkingDirectory={ROOT}
EnvironmentFile={ENV_FILE}
Environment=PYTHONUNBUFFERED=1
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
ExecStart={PYTHON} -m portfolio.healthcheck
StandardOutput=append:{ROOT}/data/algo/logs/health.log
StandardError=append:{ROOT}/data/algo/logs/health.log
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths={ROOT}/data /run/lock

[Install]
WantedBy=default.target
