# Template: scripts/install_units.py renders {ROOT}. Times are America/New_York, so the schedule does not depend on the host clock.
# Persistent is off: a slot missed while the machine was off is skipped, not run late.
[Unit]
Description=Algo options research report (timer)

[Timer]
OnCalendar=*-*-* 17:00:00 America/New_York
Unit=options-research.service

[Install]
WantedBy=timers.target
