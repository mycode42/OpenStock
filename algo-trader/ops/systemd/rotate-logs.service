# Template: scripts/install_units.py renders {ROOT}, {ENV_FILE}, and {PYTHON} into ~/.config/systemd/user.
# Started by rotate-logs.timer (America/New_York). Output appends to data/algo/logs/.
[Unit]
Description=Algo log rotation

[Service]
Type=oneshot
TimeoutStartSec=12h
WorkingDirectory={ROOT}
EnvironmentFile={ENV_FILE}
Environment=PYTHONUNBUFFERED=1
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
ExecStart={PYTHON} scripts/rotate_logs.py
StandardOutput=append:{ROOT}/data/algo/logs/rotate.log
StandardError=append:{ROOT}/data/algo/logs/rotate.log
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths={ROOT}/data /run/lock

[Install]
WantedBy=default.target
