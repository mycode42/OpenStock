# Algo Trader environment. Copy to .env and fill in private credentials.

# Dedicated Alpaca paper account used by the Algo service
# Alpaca ALGO Trading account
ALPACA_EQUITY_API_KEY=
ALPACA_EQUITY_API_SECRET=
ALPACA_EQUITY_ACCOUNT_ID=

# Alpaca Options Trading account (optional)
ALPACA_OPTIONS_API_KEY=
ALPACA_OPTIONS_API_SECRET=
ALPACA_OPTIONS_ACCOUNT_ID=

# Theta Data API (optional — for options data)
THETA_DATA_API_KEY=

# LLM providers (only needed if NOT using Ollama)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=

# Analysis and report model. Hosted: LLM_PROVIDER=OpenAI, Anthropic, Groq (needs its API key above).
# Local: LLM_PROVIDER=Ollama with LLM_MODEL=<model you pulled>; or LLM_PROVIDER=OpenAI with OPENAI_API_BASE
# set to an OpenAI-compatible server (llama.cpp, vLLM, LM Studio) and OPENAI_API_KEY set to any value.
LLM_PROVIDER=
LLM_MODEL=
