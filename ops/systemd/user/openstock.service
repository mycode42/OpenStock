# Template: scripts/install-user-units.sh renders {ROOT} and {NODE} into
# ~/.config/systemd/user. Runs as the invoking user; no root needed.
[Unit]
Description=OpenStock Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory={ROOT}
EnvironmentFile={ROOT}/.env
ExecStart={NODE} {ROOT}/server.js
Restart=always
RestartSec=5
# The price monitor runs inside this service. Its one-cycle lock lives in the runtime directory, so a crash clears it.
RuntimeDirectory=openstock
Environment=MONITOR_LOCK_PATH=%t/openstock/monitor.lock

[Install]
WantedBy=default.target
