.env
/private/
node_modules/
/data/
# The Algo Trader's data folder is a symlink to ./data.
/algo-trader/data
memory/*.log
memory/*.json
*.db
*.db-wal
*.db-shm
database/*.db.backup

# Database backups hold live trade data; never commit them.
database/*.backup
# Migration backups are written next to whichever database file is in use, so match them anywhere.
*.pre-*.backup
# Database backups made by hand before risky changes (*.db.pre-*.bak); they hold live trade data.
database/*.bak
*.db.*.bak
