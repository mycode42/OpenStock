# OpenStock Environment Variables

# Telegram Bot token for notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Database path (relative or absolute)
DATABASE_PATH=/opt/openstock/database/openstock.db

# Server configuration
PORT=3000

# Bounded quote workers and per-cycle budget
MONITOR_CONCURRENCY=3
MONITOR_CYCLE_DEADLINE_MS=45000

# Telegram bot username (optional, for verification)
TELEGRAM_BOT_USERNAME=OpenStock_TelegramBot

# Cron schedule for monitoring (every minute)
MONITORING_CRON="* * * * *"

# Trade Republic UAPI (loopback sidecar)
TRADE_REPUBLIC_BASE_URL=http://127.0.0.1:8000
TRADE_REPUBLIC_TIMEOUT_MS=30000

# Trade Republic sidecar authentication is provisioned server-side. Do not put
# credentials, phone numbers, PINs, or cookies in this template.

# Primary read-only quote source. Failed or disabled SDK requests fall back to UAPI.
# Point SESSION_FILE at a private SDK session file outside this repo.
TRADE_REPUBLIC_SDK_ENABLED=true
TRADE_REPUBLIC_SDK_SESSION_FILE=
TRADE_REPUBLIC_SDK_MODULE_PATH=/opt/handelsrepublik/dist/index.js
# Used only when the saved SDK session is missing or rejected. The broker may
# ask for approval in the Trade Republic mobile app; keep these out of source control.
TRADE_REPUBLIC_SDK_PHONE_NUMBER=
TRADE_REPUBLIC_SDK_PIN=
TRADE_REPUBLIC_SDK_AUTH_TIMEOUT_MS=45000
LIVE_PRICE_REFRESH_MS=1000
