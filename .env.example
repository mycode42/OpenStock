# OpenStock Environment Variables

# Telegram Bot token for notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Database path (relative or absolute)
DATABASE_PATH=./database/openstock.db

# Server configuration
PORT=3000

# Chat that receives monitor alerts
TELEGRAM_CHAT_ID=

# Manual trading account used by the Dashboard, Monitoring and manual orders
# Manual trading account (dashboard and manual limit orders). Algo Trader paper keys live under ALPACA_EQUITY_*.
# Paper is the safe default. Set this to https://api.alpaca.markets only when you mean to trade live.
ALPACA_MANUAL_BASE_URL=https://paper-api.alpaca.markets/v2
ALPACA_MANUAL_API_KEY=
ALPACA_MANUAL_API_SECRET=
ALPACA_DATA_FEED=sip

# Algo Trader paper accounts (each base URL defaults to Alpaca Paper; any other URL needs ALPACA_ALLOW_LIVE=1)
# Live trading: set ALPACA_ALLOW_LIVE=1 and OPENSTOCK_ORDER_TOKEN. Orders are capped at $100,000 each.
ALPACA_ALLOW_LIVE=
OPENSTOCK_ORDER_TOKEN=
# --- Algo Trader: equity paper account ---

ALPACA_EQUITY_BASE_URL=https://paper-api.alpaca.markets/v2
ALPACA_EQUITY_API_KEY=
ALPACA_EQUITY_API_SECRET=
ALPACA_EQUITY_ACCOUNT_ID=


# --- Algo Trader: options paper account ---
ALPACA_OPTIONS_BASE_URL=https://paper-api.alpaca.markets/v2
ALPACA_OPTIONS_API_KEY=
ALPACA_OPTIONS_API_SECRET=
ALPACA_OPTIONS_ACCOUNT_ID=

# Interpreter the server uses to read the Algo fill report. Point it at the Algo daemon's venv;
# `poetry run` resolves a different venv once the project path changes.
ALGO_TRADER_PYTHON=

ORDER_NOTIONAL_USD=250  # default USD amount for a BUY limit
