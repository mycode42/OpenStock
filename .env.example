# OpenStock + Algo Trader environment. One file for both; keep it git-ignored.

# --- OpenStock: manual trading account (LIVE endpoint) ---
# Manual trading account (dashboard and manual limit orders). Live endpoint.
ALPACA_MANUAL_BASE_URL=https://api.alpaca.markets
ALPACA_MANUAL_API_KEY=
ALPACA_MANUAL_API_SECRET=
ALPACA_MANUAL_ACCOUNT_ID=
ALPACA_DATA_FEED=sip

# --- Order routing (manual limit orders from Trigger levels) ---
# Live trading: set ALPACA_ALLOW_LIVE=1 and OPENSTOCK_ORDER_TOKEN. Orders are capped at $100,000 each.
ALPACA_ALLOW_LIVE=
OPENSTOCK_ORDER_TOKEN=
ORDER_NOTIONAL_USD=250

# --- OpenStock: other settings ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
DATABASE_PATH=./database/openstock.db
PORT=3000
TELEGRAM_BOT_USERNAME=your_telegram_bot_username_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
MONITORING_CRON="* * * * *"
# Set to 1 only behind a reverse proxy that overwrites any X-Forwarded-Host and X-Forwarded-Proto the client sends.
OPENSTOCK_TRUST_PROXY=

# --- Algo Trader: equity paper account---
ALPACA_EQUITY_BASE_URL=https://paper-api.alpaca.markets/v2
ALPACA_EQUITY_API_KEY=
ALPACA_EQUITY_API_SECRET=
ALPACA_EQUITY_ACCOUNT_ID=

# --- Algo Trader: options paper account ---
ALPACA_OPTIONS_BASE_URL=https://paper-api.alpaca.markets/v2
ALPACA_OPTIONS_API_KEY=
ALPACA_OPTIONS_API_SECRET=
ALPACA_OPTIONS_ACCOUNT_ID=

# --- Algo Trader: momentum paper account ---
ALPACA_MOMENTUM_BASE_URL=https://paper-api.alpaca.markets/v2
ALPACA_MOMENTUM_API_KEY=
ALPACA_MOMENTUM_API_SECRET=
ALPACA_MOMENTUM_ACCOUNT_ID=

# --- Algo Trader: data and LLM providers ---
THETA_DATA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
LLM_PROVIDER=OpenAI
LLM_MODEL=gpt-6-luna

# Still points at the running algo-trader install until its data directory moves.
ALGO_TRADER_PYTHON=