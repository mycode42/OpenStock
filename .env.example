# OpenStock Environment Variables

# Verified Trade Republic EUR mappings use direct broker quotes; Yahoo Finance is the free fallback.

# Telegram Bot token for notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Database path (relative or absolute)
DATABASE_PATH=/opt/openstock/database/openstock.db

# Server configuration
PORT=3000

# Exchange rate cache duration (seconds)
EXCHANGE_RATE_CACHE_SECONDS=3600

# Telegram bot username (optional, for verification)
TELEGRAM_BOT_USERNAME=OpenStock_TelegramBot

# Cron schedule for monitoring (every minute)
MONITORING_CRON="* * * * *"

# Trade Republic UAPI (loopback sidecar)
TRADE_REPUBLIC_BASE_URL=http://127.0.0.1:8000
TRADE_REPUBLIC_TIMEOUT_MS=30000

# Trade Republic sidecar authentication is provisioned server-side. Do not put
# credentials, phone numbers, PINs, or cookies in this template.

# Optional Handelsrepublik SDK primary quote source. When enabled, the monitor
# uses its read-only executable bid/ask quote before the sidecar, pytr, and Yahoo.
# Point SESSION_FILE at a root-owned/private SDK session file outside this repo.
TRADE_REPUBLIC_SDK_ENABLED=false
TRADE_REPUBLIC_SDK_SESSION_FILE=
TRADE_REPUBLIC_SDK_MODULE_PATH=/opt/handelsrepublik/dist/index.js

# pytr display-only fallback price source. It reads its own authenticated
# credentials and session from /home/openclaw/.pytr; do not put phone/PIN in this file.
PYTR_COMMAND=/opt/pytr-venv/bin/pytr
PYTR_TIMEOUT_MS=8000
# When both the sidecar and pytr quote paths fail, request an app-confirmed v2
# pytr login. A dedicated systemd timer runs the login outside the monitor.
PYTR_LOGIN_RECOVERY_COOLDOWN_SECONDS=900
LIVE_PRICE_REFRESH_MS=1000

# Live manual orders are fail-closed. Keep these values until explicitly enabling trading.
TRADE_REPUBLIC_LIVE_ENABLED=false
TRADE_REPUBLIC_DRY_RUN=true
TRADE_REPUBLIC_LIVE_ACK=false
TRADE_REPUBLIC_KILL_SWITCH=true
TRADE_REPUBLIC_MAX_ORDER_EUR=0
