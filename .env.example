# Algo Trader environment. Copy to .env and fill in private credentials.

# Dedicated Alpaca paper account used by the Algo service
ALPACA_ALGO_API_KEY=
ALPACA_ALGO_API_SECRET=
ALPACA_ALGO_ACCOUNT_ID=

# Dedicated Alpaca paper account used only by options.paper
ALPACA_OPTIONS_API_KEY=
ALPACA_OPTIONS_API_SECRET=
ALPACA_OPTIONS_ACCOUNT_ID=
# OPRA requires an eligible market-data subscription; indicative data is delayed.
ALPACA_OPTIONS_FEED=opra
# Optional path to a JSON options config override (default: data/options/config.json)
# ALPACA_OPTIONS_CONFIG=

# Shared Alpaca market-data subscription
ALPACA_DATA_TIER=algo_trader_plus

# LLM providers used by the Event Driven analyst snapshot
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
LLM_PROVIDER=OpenAI
LLM_MODEL=gpt-6-luna

# Optional SEC EDGAR User-Agent override
# SEC_USER_AGENT=YourApp admin@example.com
