# OpenStock Environment Variables

# Telegram Bot token for notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Database path (relative or absolute)
DATABASE_PATH=./database/openstock.db

# Server configuration
PORT=3000

# Chat that receives monitor alerts
TELEGRAM_CHAT_ID=

# Dedicated Alpaca live account used by Dashboard and Monitoring Service
# Alpaca LIVE account (manual trading). Algo Trader paper keys live in the same file under ALPACA_ALGO_*.
# Paper is the safe default. Set the live URL only when you mean to trade the live account.
ALPACA_LIVE_BASE_URL=https://paper-api.alpaca.markets/v2
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_API_SECRET=
ALPACA_DATA_FEED=sip

# Algo Trader paper accounts (algo sleeves are paper-only; the URL is refused if it is not paper)
ALPACA_ALGO_BASE_URL=https://paper-api.alpaca.markets/v2
ALPACA_ALGO_API_KEY=
ALPACA_ALGO_API_SECRET=
ALPACA_ALGO_ACCOUNT_ID=
ALPACA_OPTIONS_BASE_URL=https://paper-api.alpaca.markets/v2
ALPACA_OPTIONS_API_KEY=
ALPACA_OPTIONS_API_SECRET=
ALPACA_OPTIONS_ACCOUNT_ID=

# Optional Algo Trader data directory. Relative paths resolve from the checkout directory.
ALGO_TRADER_ROOT=./algo-trader

# Order routing. Off by default. Set ORDERS_ENABLED=true and a long random token to place manual limit orders.
ORDERS_ENABLED=false
OPENSTOCK_ORDER_TOKEN=
ORDER_NOTIONAL_USD=250
ORDER_MAX_NOTIONAL_USD=500
ORDER_DAILY_BUY_LIMIT_USD=2000
