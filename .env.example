# OpenStock Environment Variables

# Twelve Data API key for stock prices
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here

# Telegram Bot token for notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Database path (relative or absolute)
DATABASE_PATH=/home/ubuntu/openstock/database/openstock.db

# Server configuration
PORT=3000

# Twelve Data cache duration (seconds)
EXCHANGE_RATE_CACHE_SECONDS=3600

# Telegram bot username (optional, for verification)
TELEGRAM_BOT_USERNAME=OpenStock_TelegramBot

# Cron schedule for monitoring (every minute)
MONITORING_CRON="* * * * *"
