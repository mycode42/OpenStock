# AI Hedge Fund — Environment Variables
# Copy this to .env and fill in your keys.
# .env is gitignored and will NOT be committed.

# Alpaca Paper Trading — Primary / Swing account (required for Swing orders)
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Required: account ID or account number shown in Alpaca. The executor
# verifies this against the account returned by the broker before trading.
ALPACA_ACCOUNT_ID=

# Alpaca Day Trading account (required for Day orders). Day must use its own
# paper account because its daily flatten acts on every position in that account.
ALPACA_DAY_API_KEY=
ALPACA_DAY_API_SECRET=
ALPACA_DAY_ACCOUNT_ID=

# Dedicated Algo paper account (required for the Algo service)
ALPACA_ALGO_API_KEY=
ALPACA_ALGO_API_SECRET=
ALPACA_ALGO_ACCOUNT_ID=

# Financial data (DEPRECATED — no longer required)
# api.py now uses free sources: yfinance + SEC EDGAR XBRL.
# The old financialdatasets.ai implementation is backed up as api_original.py.
# To revert: copy src/tools/api_original.py to src/tools/api.py
# FINANCIAL_DATASETS_API_KEY=

# SEC EDGAR requires a User-Agent header (name + email). Optional override:
# SEC_USER_AGENT=YourApp admin@example.com

# LLM providers (only needed if NOT using Ollama)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=

# Optional local Ollama advisor can reorder only strategies allowed by the
# deterministic regime filter; it cannot create signals or place orders.
STRATEGY_REGIME_LLM_ENABLED=true
STRATEGY_REGIME_LLM_MODEL=phi3:mini
# Uses OLLAMA_BASE_URL (default http://localhost:11434) when enabled.

# Alpaca market-data subscription. Keep "basic" until Algo Trader Plus is active.
# Basic: IEX regular-session feed; delayed BOATS history + indicative overnight quotes.
# Plus: SIP regular-session feed; real-time BOATS overnight history and quotes.
ALPACA_DATA_TIER=basic

# A2A Peer Signal Sharing (optional — intel_exchange.py)
# Configure if you run two swarm-trader instances and want them to share signals.
# Generate tokens with: openssl rand -base64 24 | tr -d '=+/' | cut -c1-32
SWARM_AGENT_NAME=my-agent
PEER_A2A_URL=http://peer-host:9092/a2a/tasks/send
PEER_A2A_TOKEN=
