# OpenStock Environment Variables

# Telegram Bot token for notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Database path (relative or absolute)
DATABASE_PATH=./database/openstock.db

# Server configuration
PORT=3000

# Chat that receives monitor alerts
TELEGRAM_CHAT_ID=

# Dedicated Alpaca live account used by Dashboard and Monitoring Service
# Alpaca LIVE account (manual trading). Algo Trader paper keys live in the same file under ALPACA_ALGO_*.
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_API_SECRET=
ALPACA_DATA_FEED=sip

# Optional Algo Trader data directory. Relative paths resolve from the checkout directory.
ALGO_TRADER_ROOT=./algo-trader
